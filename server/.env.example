# .env.example - Local Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# NOTE: Database and auth values (DATABASE_URL, DATABASE_URL_UNPOOLED,
# NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL) are NOT set here. The Neon CLI
# manages them in the repo-root .env.local, regenerated by `neon deploy`.
# Run `neon link` if that file is missing. Do not duplicate them here.

# Pixelation Pipeline (Gemini API for style normalization)
GEMINI_API_KEY=placeholder_key

# Image Storage / AWS S3 (If using remote storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_key
AWS_SECRET_ACCESS_KEY=placeholder_secret
AWS_S3_BUCKET_NAME=pixelrack-dev-images

# External API Limits
MAX_UPLOAD_SIZE_MB=5
