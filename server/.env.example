# .env.example - Local Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:localpassword@localhost:5432/pixelrack_dev

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Image Storage / AWS S3 (If using remote storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_key
AWS_SECRET_ACCESS_KEY=placeholder_secret
AWS_S3_BUCKET_NAME=pixelrack-dev-images

# External API Limits
MAX_UPLOAD_SIZE_MB=5
