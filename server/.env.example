# .env.example - Local Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# NOTE: Database and auth values (DATABASE_URL, DATABASE_URL_UNPOOLED,
# NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL) are NOT set here. The Neon CLI
# manages them in the repo-root .env.local, regenerated by `neon deploy`.
# Run `neon link` if that file is missing. Do not duplicate them here.

# Pixelation Pipeline
# Which provider redraws the photo: cloudflare | gemini | local
# cloudflare = Stable Diffusion img2img on Workers AI, free tier, needs the
# two values below. Falls back to local background removal on any failure.
PIXELATION_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Higher strength restyles harder but drifts further from the real car.
CF_IMG2IMG_STRENGTH=0.62
CF_IMG2IMG_GUIDANCE=8.5
# Gemini redraws the photo as pixel art. Image generation has NO free tier, so
# this is billed per upload (~$0.04) and needs billing enabled on the Google
# Cloud project. Without a key the app falls back to free local background
# removal, which is lower quality.
GEMINI_API_KEY=placeholder_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Caps how long the local fallback inference may take per upload.
BG_REMOVAL_TIMEOUT_MS=60000

# Image Storage / AWS S3 (If using remote storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_key
AWS_SECRET_ACCESS_KEY=placeholder_secret
AWS_S3_BUCKET_NAME=pixelrack-dev-images

# External API Limits
MAX_UPLOAD_SIZE_MB=5
