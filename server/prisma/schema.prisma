generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// App profile only - credentials/sessions live in Neon Auth's own
// neon_auth.user table. id matches the Neon Auth user id (JWT `sub`).
model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  cars Car[]

  @@map("users")
}

model Car {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  originalImageUrl String   @map("original_image_url")
  pixelImageUrl    String   @map("pixel_image_url")
  name             String
  series           String?
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cars")
}

model Environment {
  id            String  @id @default(uuid())
  name          String
  backgroundUrl String  @map("background_url")
  isPremium     Boolean @default(false) @map("is_premium")

  @@map("environments")
}
